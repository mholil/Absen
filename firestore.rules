rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'mholil0513@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.role is string && data.role.size() >= 4 && data.role.size() <= 32 &&
        data.role in ['admin', 'kepala_sekolah', 'wali_kelas', 'guru_piket'] &&
        data.createdAt is timestamp;
    }

    function isValidSchoolRecord(data) {
      return data.keys().hasAll([
          'id',
          'section',
          'ownerId',
          'schoolName',
          'academicYear',
          'recordCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'section',
          'ownerId',
          'schoolName',
          'academicYear',
          'recordCount',
          'records',
          'settingsData',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.section is string && data.section.size() >= 1 && data.section.size() <= 64 &&
        data.section in [
          'settings',
          'classes',
          'students',
          'attendance',
          'notes',
          'bills',
          'payments',
          'admin_extra'
        ] &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 200 &&
        data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 32 &&
        data.recordCount is int && data.recordCount >= 0 && data.recordCount <= 5000 &&
        (!('records' in data) || (data.records is list && data.records.size() <= 5000 && (data.records.size() == 0 || data.records[0] is map))) &&
        (!('settingsData' in data) || (data.settingsData is map && data.settingsData.keys().size() <= 50)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Collection: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());

      allow create: if isSignedIn() &&
        isValidId(adminId) &&
        isValidAdminUser(incoming()) &&
        incoming().uid == adminId &&
        incoming().createdAt == request.time &&
        isBootstrappedAdmin();

      allow update: if isSignedIn() &&
        isValidId(adminId) &&
        isValidAdminUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role']) &&
        isBootstrappedAdmin();

      allow delete: if isSignedIn() && isValidId(adminId) && isBootstrappedAdmin();
    }

    // Collection: /school_records/{recordId}
    match /school_records/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isSignedIn() &&
        isValidId(recordId) &&
        isValidSchoolRecord(incoming()) &&
        incoming().id == recordId &&
        incoming().section == recordId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(recordId) &&
        isValidSchoolRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().section == existing().section &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            (existing().ownerId == request.auth.uid || isAdmin()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'ownerId',
              'schoolName',
              'academicYear',
              'recordCount',
              'records',
              'settingsData',
              'updatedAt'
            ])
          )
        );

      allow delete: if isSignedIn() && isValidId(recordId) && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
